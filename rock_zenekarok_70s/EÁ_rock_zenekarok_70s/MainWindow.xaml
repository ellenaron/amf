<Window x:Class="EÁ_rock_zenekarok_70s.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EÁ_rock_zenekarok_70s"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Background>
        <ImageBrush ImageSource="Images/koncert.jpg"
                    Stretch="UniformToFill" />
    </Window.Background>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
            <Label Content="Rockzenekarok adtai:"
                   FontSize="30"
                   Margin="10"
                   Foreground="white"/>
            <ListBox HorizontalAlignment="Stretch"
                     Height="200"
                     Margin="10 0 10 10"
                     ItemsSource="{Binding BandList}"
                     SelectedItem="{Binding SelectedBand}"/>
            <Button HorizontalAlignment="Left"
                    Content="Adatok betöltése"
                    FontSize="20"
                    Margin="10 0 0 10"
                    Padding="20 10"
                    Command="{Binding LoadBandDataCommand}"/>
            <Label Content="Aktív évek száma:"
                   HorizontalAlignment="Left"
                   Margin="10 0 0 10"
                   Foreground="White"
                   FontSize="20"/>
            <Label Content="{Binding SelectedBandActive}"
                   HorizontalAlignment="Center"
                   Margin="10 0 0 10"
                   Foreground="White"
                   FontSize="20"/>
        </StackPanel>
        <Image Source="{Binding SelectedBandUrl}"
               Grid.Column="1"
               HorizontalAlignment="Stretch"
               VerticalAlignment="top"
               Stretch="Uniform"
               Margin="10"/>
    </Grid>
</Window>
